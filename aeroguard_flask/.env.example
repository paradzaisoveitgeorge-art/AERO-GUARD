# Copy this file to `.env` for local dev and fill in real values.
# `.env` is gitignored — never commit secrets.
# On Render.com everything below is set via the dashboard or render.yaml.

# --- Required in all environments -----------------------------------
FLASK_ENV=development          # set to "production" when deployed
SECRET_KEY=change-me-to-a-long-random-string
PORT=5050

# --- Database -------------------------------------------------------
# Local: leave DATABASE_URL unset → SQLite in `instance/aeroguard.db`
# Prod:  Render injects DATABASE_URL automatically from the managed
#        Postgres. `postgres://` and `postgresql://` are both fine —
#        app.py normalises them.
# DATABASE_URL=postgresql://user:pass@host:5432/aeroguard

# --- Event stream (simulated GDS activity) --------------------------
# 0 disables the APScheduler background stream (useful for tests).
AEROGUARD_STREAM=1
AEROGUARD_STREAM_MIN_S=45
AEROGUARD_STREAM_MAX_S=90
